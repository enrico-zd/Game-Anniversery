{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".validate": "$room.matches(/^[a-z0-9-]{1,40}$/)",
        "presence": {
          ".read": "auth != null",
          "$peer": {
            ".write": "auth != null && (!newData.exists() ? (!data.exists() || data.child('uid').val() === auth.uid) : (newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['uid', 'presence', 't']) && $peer.matches(/^[a-z0-9]{1,40}$/)",
            "uid": { ".validate": "newData.isString()" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "presence": { ".validate": "newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        },
        "notes": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "items": {
              "$i": {
                ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.hasChild('text')",
                "text": { ".validate": "newData.isString() && newData.val().length <= 160" },
                "id": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "color": { ".validate": "newData.isNumber()" },
                "who": { ".validate": "newData.isString() && newData.val().length <= 8" },
                "t": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
